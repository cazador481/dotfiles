# Treat all files as text and normalize to LF in the repo
* text=auto

# Explicitly enforce LF for source files
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Files that must stay CRLF, even on Linux/macOS
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.exe  binary
