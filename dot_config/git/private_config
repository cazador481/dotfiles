[color]
	ui = true
[push]
	default = simple
    followTags = true
    autoSetupRemote = True
[pull]
    rebase = true
[github]
	user = cazador481
[git-p4]
	user = eash
    #exportLabels = true
	skipSubmitEdit = 1
	detectCopies = true
	detectRenames = true
	importLabels = true
	keepemptycommits = true
[http]
	sslVerify = false
[core]
    # pager = diff-so-fancy | less --tabs=4 -RFX
	attributesfile = /home/eash/.config/git/.gitattributes
	commentChar = ";"
	fsmonitor = true
	untrackedcache = true

[merge "poetrylock"]
    name = Poetry lock merge driver
    driver = /home/eash/.config/git/bin/poetry_lock_merge_driver.sh %P

[alias] 
    root = rev-parse --show-toplevel
    info = nv info

    pop = stash pop
    push = stash push

    name = "!git symbolic-ref --quiet --short HEAD || git rev-parse --short HEAD"  # name of current branch
    # rename branch to done-branch
    cb = checkout -b
    co = "!git checkout `git branches | fzf --ansi |cut -f1 -d' '`"
    desc = branch --edit-description
    del-shelf = "!git update-ref -d refs/remotes/p4/unshelve/{}"

# as2 aliases
    as2submit = nv as2-submit
    as2submit-p= "!p4 unshelve -s `git get-shelf` -c `git get-shelf` && as2 --nosearch submit -c `git get-shelf` -p && p4 revert //..."
    as2submit-f= "!p4 unshelve -s `git get-shelf` -c `git get-shelf` && as2 --nosearch submit -c `git get-shelf` -f && p4 revert //..."
    as2submit-t= "!p4 unshelve -s `git get-shelf` -c `git get-shelf` && as2 --nosearch submit -c `git get-shelf` -t && p4 revert //..."
    as2submit-k= "!p4 unshelve -s `git get-shelf` -c `git get-shelf` && as2 --nosearch submit -c `git get-shelf` -k && p4 revert //..."

    # parent p4 commit
    parent-commit = "!git merge-base `git name` `git parent`"

    parent = "!git config branch.`git name`.parent "


    get-shelf = "!git config --get branch.`git name`.shelf"
    set-shelf = "!git config branch.`git name`.shelf "
    get-review = "!git config --get branch.`git name`.review"
    set-review = "!git config branch.`git name`.review "
    open-review ="!timeout 5 doitclient www https://ccollab-prd.nvidia.com/ui#review:id=`git get-review`"

    set-bundle = "!git config branch.`git name`.bundle "
    get-bundle = "!git config branch.`git name`.bundle "


# nvbugs commands
    bug = "!git config branch.`git name`.bug "
    open-bug ="!doitclient www http://nvbugs/`git bug`"


    set-rebase-onto = "!git config branch.`git name`.rebase-onto- "
    get-rebase-onto = "!git config --get branch.`git name`.rebase-onto-"

# jira
    get-jira = "!git config --get branch.`git name`.jira"
    set-jira = "!git config branch.`git name`.jira "
    jiracomponent= "!git config nv-git.jiraComponent " 
    open-jira ="!doitclient www http://jirasw.nvidia.com/browse/`git get-jira`"

    print-desc = "!git config --get branch.`git name`.description|head -n 1"

    # remove squashed branches
    rm-squash = "!git branch |grep -o '.*-squash$'|xargs -I{} git branch -D {};"

    done=nv done
    rm-done = "!git branch |grep -o '.*-done'|xargs -I{} git branch -D {};"
    # Remove directories that no longer exist at origin
    rm-prune = "!sh -c 'git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -d'"

    #task warrior id
    t-id = "!git config --get branch.`git name`.taskwarrior-id "
    create-gitlab="!git push --set-upstream ssh://git@gitlab-master.nvidia.com:12051/eash/$(git rev-parse --show-toplevel | xargs basename|cut -d '.' -f1).git master"
    my-clean = clean -e .neoconf.json -e .vim -e .lvimrc -e .gitignore -e .p4config -e .crucible -e .libcustom -e TOT -e .perltidyrc -e .workspace -e .envrc -e Taskfile.yml

##### ALIAS MANAGMENT####

  # Show our defined alias list
    aliases = "!git config --get-regexp '^alias\\.' | cut -c 7- | sed 's/ / = /'"

    add-alias = "!f() { [ $# = 3 ] && git config $1 alias.\"$2\" \"$3\" && return 0 || echo \"Usage: git add-(local|global)-alias <new alias> <original command>\" >&2 && return 1; }; f"
    add-global-alias = "!git add-alias --global"
    add-local-alias = "!git add-alias --local"

    # Rename an alias
    rename-alias = "!f() { [ $# = 3 ] && [ $2 != $3 ] && [ ! -z \"$(git config $1 --get alias.$2)\" ] && [ -z \"$(git config $1 --get alias.$3)\" ] && git config $1 alias.$3 \"$(git config $1 --get alias.$2)\" && git config $1 --unset alias.$2 && return 0 || echo \"Usage: git rename-(local|global)-alias <alias existing name> <new alias name>\nThe alias you are going to rename must exist and new name must not exist.\" >&2 && return 1; };f"
    rename-global-alias = "!git rename-alias --global"
    rename-local-alias = "!git rename-alias --local"

##### Branch management ####
    rename = "!git nv rename"
    new = "!git nv new"
	reset-p4master = reset p4/master --hard

	release = "!cd_hwinf && make release"

# worktree
    wt-new = "!f() { git worktree  add -q -b $1 `git root`/../$1 p4/master && echo `git root`/../$1;}; f"
    wt = "!f() { \
    branch=\"$1\"; \
    if [ -z \"$branch\" ]; then \
        echo \"usage: git wt <branch>\" >&2; \
        return 1; \
    fi; \
    path=\"$(git root)/../$branch\"; \
    if git show-ref --quiet --verify \"refs/heads/$branch\"; then \
        git worktree add -q \"$path\" \"$branch\" || return 1; \
    else \
        git worktree add -q -b \"$branch\" \"$path\" p4/master || return 1; \
    fi; \
    exec \"${SHELL:-/bin/sh}\" -lc \"cd '$path' && exec \\\"${SHELL:-/bin/sh}\\\"\"; \
    }; f"

    sb = "!git branches |fzf --ansi|cut -f1 -d' '| xargs -t -I {} pueue add git nv nvci-submit --branch {}"
