#change prefix from ctrb-b to ctrl-a
unbind C-b
set -g prefix C-a
bind-key C-a send-prefix

set -g detach-on-destroy off
set -g mouse on
# bind -n WheelUpPane copy-mode

#set correct TERM, to make 256 colors work
set -g default-terminal "tmux-256color"
set-option -sa terminal-overrides ',*-256color:RGB'

# Enable true color support
set -as terminal-overrides ",*:Tc"

set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'  # undercurl support
set -as terminal-overrides ',*:Setulc=\E[58::2::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'  # underscore colours - needs tmux-3.0
set -as terminal-features ",*:hyperlinks"
# {{`{{{`}} Mouse mode toggle
bind m\
         set -g mouse on\;\
         display 'Tmux mouse:on'

bind M\
         set -g mouse off\;\
         display 'Tmux mouse:off'
# }}}

set -g history-limit 100000

# reload source file
bind-key r source-file ~/scratch/.config/tmux/tmux.conf\;\
  display  "config reloaded"

#{{`{{{`}} Pane managment
bind-key k select-pane -U
bind-key j select-pane -D
bind-key h select-pane -L
bind-key l select-pane -R
set -g base-index 1
set -g pane-base-index 1

#}}}

#{{`{{{`}} Window Management
set -g base-index 1 # start window inddices at 1
set-option -g renumber-windows on

#}}}

# faster command sequence, address vim mode switching delay
# Any less than 30 terminal escape garbage gets sent to terminal, so we set it to 30
# https://github.com/microsoft/vscode/issues/207545
set -s escape-time 30

# aggresive resize
setw -g aggressive-resize on

#{{`{{{`}} vi mode
set-window-option -g mode-key vi
bind-key -Tcopy-mode-vi 'v' send -X begin-selection
bind-key -Tcopy-mode-vi 'y' send -X copy-selection
bind-key -Tcopy-mode-vi 'r' send -X rectangle-toggle
#bind Escape copy-mode
bind-key p paste-buffer
# }}}

set-option -g xterm-keys on # to make ctrl-arrow, etc work

# sets default shell and cmd
{{ if (eq .chezmoi.osRelease.id "centos") }}
set -g default-shell '/home/utils/fish-3.6.1/bin/fish'
{{end}}

#{{`{{{`}} status window

set -g status-justify centre           # center window list for clarity
set -g status-left-length 20

 set -g status-bg black
 set -g status-fg white
 set -g status-left '#[fg=green]#S - #H'
 set -g status-right '#{cpu_icon} #{cpu_percentage}'
# }}}
#highlight active window
# set-option -g pane-active-border-fg red
# set-option -g pane-active-border-bg red

#use UTF8



#on screen time for display-panes in ms
#set -g display-panes-time 2000


#open split in same path as current
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"


#enable focus events
set -g focus-event on

set-option -ga update-environment "\
  SSH_AUTH_SOCK \
  SSH_AGENT_PID \
  SSH_AUTH_SOCK \
  SSH_CONNECTION \
  SSH_CLIENT \
  DISPLAY \
  XAUTHORITY \
  VSCODE_GIT_IPC_HANDLE \
  VSCODE_GIT_ASKPASS_MAIN \
  VSCODE_GIT_ASKPASS_NODE \
  VSCODE_IPC_HOOK_CLI"


# Enables osc52 passthrough (i.e copy and pasting)
set-window-option -g allow-passthrough on 

# tmux starts a new session if one doesn't exist on attach

#{{`{{{`}} plugins

# prefix-I to fetch plugins
# List of plugins
# set -g @plugin 'tmux-plugins/tmux-cpu'
# set -g @plugin 'tmux-plugins/tmux-open'
set -g @plugin 'tmux-plugins/tmux-fpp'

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-copycat'
set -g @plugin 'nhdaly/tmux-better-mouse-mode'

set -g @continuum-restore 'on'

set -g @plugin 'tmux-plugins/tmux-yank' 
#{{`{{{`}}
# if-shell 'test -z "$DISPLAY"' \
if-shell '[[ ${DISPLAY} ]]' \
     'set -g @override_copy_command "doitclient wclip";'
if-shell '[[ ${DISPLAY} ]]' \
     'bind-key "p" run-shell "doitclient wclip -r|tmux load-buffer - ;tmux paste-buffer"'
set -g @override_copy_command "doitclient wclip";
bind-key "p" run-shell "doitclient wclip -r|tmux load-buffer - ;tmux paste-buffer"
set -g @yank_selection 'primary'
#}}}
 
set -g @resurrect-capture-pane-contents 'on'
# set -g @plugin 'Morantron/tmux-fingers'

set -g @plugin 'christoomey/vim-tmux-navigator'

if "test ! -d ~/.tmux/plugins/tpm" \
{{ if (eq .chezmoi.osRelease.id "centos") }}
  run '/home/utils/git-2.45.2/bin/git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm'
{{ else }}
  run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm'
{{ end }}

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
#run-shell '~/.tmux/plugins/tmux-yank/yank.tmux'
# }}}

