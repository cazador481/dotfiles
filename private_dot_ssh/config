    User git
    Port 12051
    IdentityFile ~/.ssh/id_ed25519_work_gitlab

Host *.nvidia.com
    ForwardAgent yes

host 192.168.1.244
    User pi
    UserKnownHostsFile /dev/null

host localhost
    StrictHostKeyChecking no

host dc2-autosubmit-6.nvidia.com
    user autosubmit
