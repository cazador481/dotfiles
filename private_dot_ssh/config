	ForwardX11 yes
	ForwardAgent yes

host *-sim-???-???
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ForwardAgent yes

host io-xterm-*
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ForwardAgent yes


host eash.sc.vpx.nvidia.com
    UserKnownHostsFile /dev/null
    StrictHostKeyChecking no
    ForwardAgent yes
    User eash

